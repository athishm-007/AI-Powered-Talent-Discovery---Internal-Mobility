# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Website & Domain Configuration
NEXT_PUBLIC_SITE_URL=https://talentlens.vercel.app
ALLOWED_EMAIL_DOMAINS=talentlens.ai,company.com

# Demo Auth Switch
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
SEED_ADMIN_PASSWORD=hradmin123
SEED_EMPLOYEE_PASSWORD=employee123

# Optional AI Key (App runs cleanly using Fallback Provider if omitted)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here

# Optional Cloudflare R2 Credentials
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=talentlens-private-documents

# Optional Resend API Key for Transactional Emails
RESEND_API_KEY=re_your_resend_api_key_here
